# Caspian gateway. Get a sandbox key with no signup:
#   curl -s -X POST https://api.trycaspianai.com/v1/projects/sandbox \
#     -H 'Content-Type: application/json' -d '{"name":"hearsay"}'
CASPIAN_API_KEY=comm_sandbox_xxxxxxxxxxxxxxxxxxxxxxxx
CASPIAN_BASE_URL=https://api.trycaspianai.com

# Gemini — powers the tamper rewriter. Get one at https://aistudio.google.com/apikey
#
# Auth is the `x-goog-api-key` header or a `?key=` query param. An
# `Authorization: Bearer` header returns 401.
#
# Being able to list models does not mean you can call them: a key can return
# 200 from /v1beta/models and still 403 or 429 on generateContent. Run
# `python spike/llm_probe.py` to find out which models your key can actually use.
GEMINI_API_KEY=

# Optional. Leave blank and the probe picks the best model your key can reach.
GEMINI_MODEL=

# The mailbox the agent speaks from.
HEARSAY_EMAIL_USERNAME=hearsay

# Optional: bring your own Discord bot instead of Caspian's shared one.
# DISCORD_BOT_TOKEN=
